{
       "name": "zeus-media-studio",
       "version": "0.1.0",
       "description": "Zeus Media Studio - Aplicación de escritorio creada con Zeus IA",
       "author": "Zeus IA (www.zeus-ia.com)",
       "private": true,
       "main": "electron/main.js",
       "build": {
              "appId": "com.zeus.Zeus-media-studio",
              "productName": "Zeus Media Studio",
              "npmRebuild": false,
              "asar": false,
              "asarUnpack": [
                     ".next/**"
              ],
              "extraResources": [
                     {
                            "from": ".next",
                            "to": "app/.next"
                     },
                     {
                            "from": ".env.electron",
                            "to": "app/.env"
                     }
              ],
              "directories": {
                     "output": "dist"
              },
              "files": [
                     "node_modules",
                     ".next",
                     "app",
                     "public",
                     "public/Obj-3D/**/*",
                     "!public/download",
                     "package.json",
                     "next.config.js",
                     "flux-bridge.py",
                     "electron/**/*",
                     "lib/**/*",
                     "types/**/*",
                     "docs/**/*",
                     "API/**/*",
                     "serve/**/*",
                     "!serve/preview-server.exe",
                     "!serve/preview-server-setup.exe",
                     "!serve/server.rar",
                     "!serve/*.log",
                     "pocket-base/pocketbase.exe",
                     "pocket-base/pb_migrations/**/*",
                     "!pocket-base/pb_data",
                     "Api-Font-Texture/**/*"
              ],
              "win": {
                     "target": [
                            "nsis"
                     ],
                     "icon": "public/installer-icon.ico"
              },
              "nsis": {
                     "oneClick": false,
                     "allowToChangeInstallationDirectory": true
              },
              "mac": {
                     "target": [
                            "dmg"
                     ],
                     "category": "public.app-category.productivity"
              },
              "linux": {
                     "target": [
                            "AppImage"
                     ]
              }
       },
       "scripts": {
              "dev": "concurrently \"next dev -p 3003\" \"npx next dev -p 3006\" \"node zeus-bridge.js\"",
              "dev:main": "next dev -p 3003",
              "dev:pb": "concurrently \"npx next dev -p 3006\"",
              "pb:serve": "cd pocket-base && pocketbase.exe serve --http 127.0.0.1:8236",
              "bridge": "node zeus-bridge.js",
              "build": "next build --webpack",
              "start": "next start",
              "electron:dev": "concurrently \"next dev -p 3002\" \"node zeus-bridge.js\" \"npm run pb:serve\" \"wait-on -t 90000 http://localhost:3002 && cross-env ELECTRON_DEV_PORT=3002 electron .\"",
              "electron:dev:simple": "concurrently \"next dev -p 3002\" \"node zeus-bridge.js\" \"npm run pb:serve\" \"wait-on -t 60000 http://localhost:3002 && cross-env ELECTRON_DEV_PORT=3002 electron .\"",
              "electron:dev:standalone": "concurrently \"next dev -p 3002\" \"npx next dev -p 3006\" \"node zeus-bridge.js\" \"npm run pb:serve\" \"wait-on http://localhost:3002 && wait-on http://localhost:3006 && wait-on http://localhost:8236 && cross-env ELECTRON_TARGET=desktop ELECTRON_DEV_PORT=3002 electron .\"",
              "electron:build": "npm run build && node scripts/prepare-electron-env.js && electron-builder",
              "electron:build:win": "npm run build && node scripts/prepare-electron-env.js && electron-builder --win",
              "electron:build:mac": "npm run build && node scripts/prepare-electron-env.js && electron-builder --mac",
              "electron:build:linux": "npm run build && node scripts/prepare-electron-env.js && electron-builder --linux",
              "lint": "next lint",
              "format": "prettier --write '**/*.{js,jsx,ts,tsx,json,md}'",
              "test": "jest",
              "analyze": "ANALYZE=true next build"
       },
       "dependencies": {
              "@dnd-kit/core": "^6.3.1",
              "@dnd-kit/sortable": "^10.0.0",
              "@dnd-kit/utilities": "^3.2.2",
              "@fontsource/audiowide": "^5.3.0",
              "@headlessui/react": "^1.7.17",
              "@heroicons/react": "^2.1.5",
              "@hookform/resolvers": "^3.3.2",
              "@radix-ui/react-accordion": "^1.2.12",
              "@radix-ui/react-alert-dialog": "^1.1.15",
              "@radix-ui/react-aspect-ratio": "^1.1.7",
              "@radix-ui/react-avatar": "^1.1.10",
              "@radix-ui/react-checkbox": "^1.3.3",
              "@radix-ui/react-context-menu": "^2.2.16",
              "@radix-ui/react-dropdown-menu": "^2.1.16",
              "@radix-ui/react-hover-card": "^1.1.15",
              "@radix-ui/react-label": "^2.1.7",
              "@radix-ui/react-menubar": "^1.1.16",
              "@radix-ui/react-navigation-menu": "^1.2.14",
              "@radix-ui/react-popover": "^1.1.15",
              "@radix-ui/react-progress": "^1.1.7",
              "@radix-ui/react-radio-group": "^1.3.8",
              "@radix-ui/react-scroll-area": "^1.2.10",
              "@radix-ui/react-select": "^2.2.6",
              "@radix-ui/react-separator": "^1.1.7",
              "@radix-ui/react-slider": "^1.3.6",
              "@radix-ui/react-switch": "^1.2.6",
              "@radix-ui/react-tabs": "^1.1.13",
              "@radix-ui/react-toast": "^1.1.5",
              "@radix-ui/react-toggle-group": "^1.1.11",
              "@radix-ui/react-tooltip": "^1.0.7",
              "@react-three/drei": "^9.122.0",
              "@react-three/fiber": "^8.18.0",
              "@types/three": "^0.185.4",
              "@types/yamljs": "^0.2.34",
              "class-variance-authority": "^0.7.0",
              "clsx": "^2.0.0",
              "cmdk": "^1.1.1",
              "cors": "^2.8.6",
              "date-fns": "^2.30.0",
              "embla-carousel-react": "^8.6.0",
              "eventemitter3": "^5.0.4",
              "express": "^5.2.1",
              "ffmpeg-static": "^5.3.0",
              "fluent-ffmpeg": "^2.1.3",
              "framer-motion": "^10.18.0",
              "input-otp": "^1.4.2",
              "jszip": "^3.10.1",
              "lucide-react": "^0.294.0",
              "mediabunny": "^1.51.0",
              "multer": "^2.1.1",
              "next": "^16.1.6",
              "next-auth": "^4.24.13",
              "next-themes": "^0.2.1",
              "node-fetch": "^3.3.2",
              "opentype.js": "^2.0.0",
              "pocketbase": "^0.26.2",
              "pptxgenjs": "^1.1.5",
              "react": "^18.2.0",
              "react-day-picker": "^9.9.0",
              "react-dom": "^18.2.0",
              "react-error-boundary": "^4.0.11",
              "react-hook-form": "^7.47.0",
              "react-hot-toast": "^2.4.1",
              "react-resizable-panels": "^3.0.6",
              "react-webcam": "^7.2.0",
              "recharts": "^3.10.1",
              "sonner": "^2.0.7",
              "swagger-ui-dist": "^5.32.1",
              "swagger-ui-react": "^5.32.15",
              "swr": "^2.2.4",
              "tailwind-merge": "^1.14.0",
              "tailwindcss-animate": "^1.0.7",
              "three": "^0.186.0",
              "three-csg-ts": "^3.2.0",
              "uuid": "^13.0.0",
              "vaul": "^1.1.2",
              "yamljs": "^0.3.0",
              "zod": "^3.22.4",
              "zustand": "^4.5.7"
       },
       "devDependencies": {
              "@next/bundle-analyzer": "^14.0.0",
              "@testing-library/jest-dom": "^6.1.4",
              "@testing-library/react": "^14.0.0",
              "@types/node": "^20",
              "@types/react": "^18",
              "@types/react-dom": "^18",
              "@types/swagger-jsdoc": "^6.0.4",
              "autoprefixer": "^10.0.1",
              "concurrently": "^8.2.2",
              "cross-env": "^7.0.3",
              "cssnano": "^6.0.1",
              "electron": "^44.3.0",
              "electron-builder": "^26.7.0",
              "eslint": "^9.39.2",
              "eslint-config-next": "^16.1.6",
              "gifenc": "^1.0.3",
              "jest": "^29.7.0",
              "jest-environment-jsdom": "^30.2.0",
              "postcss": "^8",
              "postcss-flexbugs-fixes": "^5.0.2",
              "postcss-preset-env": "^9.3.0",
              "prettier": "^3.0.3",
              "prettier-plugin-tailwindcss": "^0.5.6",
              "tailwindcss": "^3.3.0",
              "typescript": "^5",
              "wait-on": "^7.2.0"
       },
       "nsis": {
              "oneClick": false,
              "perMachine": false,
              "allowToChangeInstallationDirectory": true,
              "createDesktopShortcut": true,
              "createStartMenuShortcut": true,
              "shortcutName": "Zeus Media Studio",
              "installerIcon": "public/installer-icon.ico",
              "uninstallerIcon": "public/installer-icon.ico",
              "installerHeaderIcon": "public/installer-icon.ico",
              "installerSidebar": "build/installerSidebar.bmp",
              "uninstallerSidebar": "build/installerSidebar.bmp",
              "include": "build/installer.nsh",
              "customNsisBinary": {
                     "url": "https://github.com/SoundSafari/NSISBI-ElectronBuilder/releases/download/1.0.0/nsisbi-electronbuilder-3.10.3.7z",
                     "checksum": "374cfc092fd1bd1898472df627549ecc165b0d6ba88e82deba085673aec95336"
              },
              "warningsAsErrors": false
       },
       "mac": {
              "target": "dmg",
              "icon": "public/icon.icns",
              "category": "public.app-category.developer-tools"
       },
       "linux": {
              "target": "AppImage",
              "icon": "public/icon.png",
              "category": "Development"
       }
}
