PORT=3012
# POCKETBASE_URL=http://127.0.0.1:8191

# --- ZEIA (Zeus Editor 3D Integration API) ---
# Exigir Authorization: Bearer <token> o X-API-Key en /v1. Por defecto OFF para desarrollo.
ZEIA_REQUIRE_AUTH=false
# Rate limit por IP (req/min) aplicado a /v1. 0 = deshabilitado.
ZEIA_RATE_LIMIT=240
# Duración simulada de los jobs asíncronos (render / export) en segundos.
ZEIA_JOB_SECONDS=5
# Permitir cualquier client_id/client_secret en /auth/token mientras no haya IdP real.
ZEIA_ALLOW_ANY_CLIENT=true
# Secreto del cliente cuando ZEIA_ALLOW_ANY_CLIENT=false (client_id por defecto: zeus-ai).
# ZEIA_CLIENT_SECRET=zeus-ai-secret
