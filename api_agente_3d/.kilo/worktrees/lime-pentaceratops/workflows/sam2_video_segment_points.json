{
  "1": {
    "inputs": {
      "video": "placeholder.mp4",
      "force_rate": 30,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    },
    "class_type": "VHS_LoadVideo",
    "_meta": { "title": "Cargar vídeo (VHS)" }
  },
  "2": {
    "inputs": {
      "model": "sam2.1_hiera_large.safetensors",
      "segmentor": "video",
      "device": "cuda",
      "precision": "fp16"
    },
    "class_type": "DownloadAndLoadSAM2Model",
    "_meta": { "title": "Cargar SAM2 (modo vídeo)" }
  },
  "3": {
    "inputs": {
      "sam2_model": ["2", 0],
      "image": ["1", 0],
      "keep_model_loaded": false
    },
    "class_type": "Sam2Segmentation",
    "_meta": { "title": "Segmentar (puntos inyectados por el bridge)" }
  },
  "4": {
    "inputs": {
      "mask": ["3", 0]
    },
    "class_type": "MaskToImage",
    "_meta": { "title": "Máscara → Imagen" }
  },
  "5": {
    "inputs": {
      "images": ["4", 0],
      "frame_rate": 30,
      "loop_count": 0,
      "filename_prefix": "sam2_mask",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    },
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Guardar vídeo de máscaras" }
  }
}